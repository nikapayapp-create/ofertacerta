# OBRIGATÓRIAS EM PRODUÇÃO
ADMIN_PASSWORD=
AUTH_SECRET=

# OPCIONAL: o Netlify injeta NETLIFY_DB_URL automaticamente quando o Netlify Database está ativo.
# Use apenas se estiver conectando manualmente a um PostgreSQL compatível.
NETLIFY_DB_URL=

# OPCIONAIS: habilitam o importador oficial do Mercado Livre.
MERCADOLIVRE_ACCESS_TOKEN=
MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=

# OPCIONAL: nome público exibido no cabeçalho e metadados.
PUBLIC_SITE_NAME=OfertaCerta
